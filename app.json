{
  "expo": {
    "name": "The Wheel",
    "newArchEnabled": true,
    "slug": "thewheel",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thewheel.app"
    },
    "android": {
      "package": "com.thewheel.app"
    },
    "web": {
      "favicon": "./assets/wheel-icon.png"
    },
    "icon": "./assets/wheel-icon.png",
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "newArchEnabled": true
          },
          "android": {
            "newArchEnabled": true
          }
        }
      ],
      "expo-secure-store"
    ]
  }
}
